<% for (const item of items) { %>
<div class="research-item<%= item.compact ? " compact" : "" %><%= item.placeholder ? " ri-placeholder" : "" %>"><h3 class="ri-title"><%= item.title %></h3><% if (item.authors || item.venue) { %><p class="ri-meta"><%= item.authors || "" %><% if (item.venue) { %><%- item.authors ? " · " : "" %><em><%= item.venue %></em><% } %></p><% } %><% var _desc = item.description == null ? "" : String(item.description); if (_desc.replace(/<!--[\s\S]*?-->/g, "").trim().length) { %><p class="ri-desc"<%- item.showFullAbstract === true ? "" : ' data-collapsible' %>><%= _desc %></p><% } %><% if (item.embargo) { %><span class="embargo-badge"><%= (typeof item.embargo === "string") ? item.embargo : "Under policy embargo — available upon request" %></span><% } %><% if (item.doi) { %><a class="ri-doi" href="https://doi.org/<%= item.doi %>" target="_blank" rel="noopener">DOI: <%= item.doi %> →</a><% } %></div>
<% } %>
